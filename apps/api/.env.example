DATABASE_URL="file:./dev.db"
# For PostgreSQL production:
# DATABASE_URL="postgresql://USER:PASSWORD@HOST:5432/detsbee?sslmode=require"

JWT_SECRET="replace-with-long-random-secret"
JWT_EXPIRES_IN="7d"
COOKIE_SECURE="true"
CLIENT_ORIGIN="https://your-detsbee-domain.com"
PORT=3001
NODE_ENV="production"
DEMO_MODE="false"
TOKEN_PEPPER="replace-with-another-long-random-secret"
# Required in production for password recovery email (Gmail 2-Step Verification App Password).
GMAIL_USER="your-sender@gmail.com"
GMAIL_APP_PASSWORD="your-16-character-app-password"
